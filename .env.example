# Canonical production origin, no trailing slash. Used for sitemap, canonicals, JSON-LD and OG URLs.
NEXT_PUBLIC_SITE_URL=https://www.apx-fs.co.uk

# Sister site, used in schema/sameAs style links where needed.
NEXT_PUBLIC_APX_MEP_URL=https://www.apx-mep.co.uk

# Sanity CMS (projects). Defaults match project v7rfd3px / production if unset.
NEXT_PUBLIC_SANITY_PROJECT_ID=v7rfd3px
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret for POST /api/revalidate (Sanity webhook → cache bust).
# Set the same value in Sanity Manage → API → Webhooks query string ?secret=...
SANITY_REVALIDATE_SECRET=

# Resend (contact + careers forms)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFY_EMAIL=

# Cloudflare Turnstile (contact + careers). Leave empty locally to skip.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare Web Analytics (+ Core Web Vitals). Public token from
# Dashboard → Analytics & Logs → Web Analytics → Manage site.
# Leave empty to disable. Must be set at build time for production.
# NEXT_PUBLIC_CF_BEACON_TOKEN=

# Optional Google Business reviews embed used on the homepage slot.
NEXT_PUBLIC_GOOGLE_REVIEWS_EMBED_URL=

# Search Console / Bing: only set after you receive a token.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Full list for Cloudflare dashboard: see CLOUDFLARE_ENV.md
