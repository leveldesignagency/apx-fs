# Canonical production origin, no trailing slash. Used for sitemap, canonicals, JSON-LD and OG URLs.
NEXT_PUBLIC_SITE_URL=https://www.apx-fs.co.uk

# Sister site, used in schema/sameAs style links where needed.
NEXT_PUBLIC_APX_MEP_URL=https://www.apx-mep.co.uk

# Optional Google Business reviews embed used on the homepage slot.
NEXT_PUBLIC_GOOGLE_REVIEWS_EMBED_URL=

# Google Search Console: do not set this until Google gives you a token.
# Search Console > Add property > HTML tag. Paste only the content="..." value into Vercel env:
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=the_token_from_google
# Same for Bing Webmaster (msvalidate.01):
# NEXT_PUBLIC_BING_SITE_VERIFICATION=the_token_from_bing
